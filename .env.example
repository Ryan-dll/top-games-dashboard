# --- Client-side (Vite) ---
# Must be prefixed with VITE_ so Vite exposes them to browser code.
# Used for reading snapshots and the manual "Snapshot now" button.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Server-side only (Vercel) ---
# Set these in the Vercel project's Environment Variables settings, NOT in
# this file's committed form. They must NOT have a VITE_ prefix, or Vite
# would bundle them into client-side JS.
# Used only by api/snapshot.js, invoked by Vercel Cron.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=a-random-string-at-least-16-chars
